{
  "$schema": "https://raw.githubusercontent.com/nicholasgasior/tauri-config-schema/tauri-v2/schema.json",
  "productName": "ASCII Art Generator",
  "version": "1.0.0",
  "identifier": "com.ascii-viewer.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ASCII Art Generator",
        "label": "main",
        "width": 960,
        "height": 700,
        "minWidth": 500,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/brian-dev25/ASCII-Tools/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0N0U0QzQ4Qjc1NDRDMTkKUldRWlRGUzNTRXgrVkZCQUVFUjNQWldONEtoU1hrQzJLOHFON3VlYmFXVlhzcTBpY3BBcXAwUWYK"
    }
  }
}
